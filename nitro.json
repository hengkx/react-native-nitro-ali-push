{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["alipush"],
  "ios": {
    "iosModuleName": "NitroAliPush"
  },
  "android": {
    "androidNamespace": ["alipush"],
    "androidCxxLibName": "NitroAliPush"
  },
  "autolinking": {
    "AliPushPlugin": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAliPushPlugin"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridAliPushPlugin"
      }
    }
  },
  "ignorePaths": ["**/node_modules"],
  "gitAttributesGeneratedFlag": false
}
