require "json"

package = JSON.parse(File.read(File.join(__dir__, "package.json")))

Pod::Spec.new do |s|
  s.name         = "react-native-nitro-ali-push"
  # Nitro 生成的 C++ 桥接层期望 Swift 模块名为 iosModuleName（nitro.json 里的 NitroAliPush），
  # 否则 Xcode 不会生成 NitroAliPush-Swift.h，C++ 桥接编译报
  # "autogenerated Swift header cannot be found"。保留 pod 名 = npm 包名以维持 RN autolinking。
  s.module_name = "NitroAliPush"
  s.version      = package["version"]
  s.summary      = package["description"]
  s.homepage     = "https://github.com/hengkx/react-native-nitro-ali-push"
  s.license      = "MIT"
  s.authors      = { "hengkx" => "ycxzhkx@gmail.com" }

  s.platforms    = { :ios => "13.0", :tvos => "13.0" }
  s.source       = { :git => "https://github.com/hengkx/react-native-nitro-ali-push.git", :tag => "v#{s.version}" }

  s.source_files = "ios/**/*.{swift,h,mm}"

  # 阿里云 SDK 隔离层（`AliPushSDKProxy`）：Swift 侧只通过此协议与 CloudPushSDK 通信，
  # 不直接 import CloudPushSDK，从而阻断其 libc++ 头（cstddef 等）与 non-modular header
  # 污染 Swift 的编译上下文。该头是纯 Foundation、不引用 CloudPushSDK.h，放进 umbrella 也不会
  # 把阿里云头带进 Swift 编译单元。
  s.public_header_files = "ios/AliPushSDKProxy.h"
  s.requires_arc = true
  s.swift_version = "5.0"

  # 引入 Nitro 生成的原生文件与构建配置（C++ 互操作、NitroModules 依赖等）。
  load 'nitrogen/generated/ios/NitroAliPush+autolinking.rb'
  add_nitrogen_files(s)

  # C++ 互操作桥接层会 #include <NitroModules/...>，其内部引用 <cstddef> 等 libc++ 头文件。
  # 部分 Xcode/SDK 组合下 clang 不会自动把 $(SDKROOT)/usr/include/c++/v1 加入搜索路径，
  # 导致编译报 "cstddef file not found"。显式补上。
  # 注意：本机 CocoaPods 版本的 spec 没有 `pod_target_xcconfig` 读取访问器，
  # 需经由 attributes_hash 读取（与上方 add_nitrogen_files 同款写法）。
  current_xcconfig = s.attributes_hash['pod_target_xcconfig'] || {}
  s.pod_target_xcconfig = current_xcconfig.merge(
    "HEADER_SEARCH_PATHS" => "$(inherited) \"$(SDKROOT)/usr/include/c++/v1\""
  )

  # 阿里云推送 SDK（CloudPushSDK）。
  #
  # 默认：走官方 CocoaPods 源 `AlicloudPush`。它不在 CocoaPods trunk，而是阿里云自己的
  # spec 仓库，因此使用方必须在 Podfile 中声明该 source（见 README「iOS 集成」）：
  #   source 'https://github.com/aliyun/aliyun-specs.git'
  #   source 'https://cdn.cocoapods.org/'
  #
  # 手动集成：把 CloudPushSDK.framework（或 CloudPushSDK.xcframework）放到本库 ios/ 目录，
  # 这里会自动改为 vendored 方式，不再依赖 AlicloudPush，两者不会同时引入。
  vendored = Dir.glob(File.join(__dir__, "ios", "CloudPushSDK.{framework,xcframework}"))
  if vendored.empty?
    s.dependency "AlicloudPush", "~> 3"
  else
    s.vendored_frameworks = vendored.map { |p| "ios/#{File.basename(p)}" }
  end

  s.dependency "React-Core"
end
